{
  "name": "Relay-and-Fuse-box — browser-first electronics",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "GitHub.vscode-pull-request-github",
        "redhat.vscode-yaml"
      ]
    }
  },
  "postCreateCommand": "bash scripts/verify-environment.sh",
  "shutdownAction": "stopContainer",
  "remoteUser": "root"
}
